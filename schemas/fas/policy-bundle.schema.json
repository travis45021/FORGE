{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/fas/policy-bundle.schema.json",
  "title": "FORGE Policy Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["bundle_id", "version", "created_at", "created_by", "status", "parent_bundle_id", "policies", "constitution", "sentinel", "rollout", "content_digest", "signatures"],
  "properties": {
    "bundle_id": {"type": "string", "pattern": "^forge-policy-bundle:[A-Za-z0-9_.-]+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "created_at": {"type": "string", "format": "date-time"},
    "created_by": {"type": "string", "minLength": 3, "maxLength": 200},
    "status": {"const": "candidate"},
    "parent_bundle_id": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^forge-policy-bundle:[A-Za-z0-9_.-]+$"}
      ]
    },
    "policies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["policy_id", "version", "digest"],
        "properties": {
          "policy_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*:[A-Za-z0-9][A-Za-z0-9_.:-]*$"},
          "version": {"type": "string", "minLength": 1, "maxLength": 100},
          "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
        }
      }
    },
    "constitution": {"$ref": "#/$defs/verification"},
    "sentinel": {"$ref": "#/$defs/verification"},
    "rollout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channels", "minimum_percent", "maximum_percent", "required_approvals"],
      "properties": {
        "channels": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["development", "canary", "production"]}},
        "minimum_percent": {"type": "integer", "minimum": 0, "maximum": 100},
        "maximum_percent": {"type": "integer", "minimum": 0, "maximum": 100},
        "required_approvals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["approval_type", "minimum_count"],
            "properties": {
              "approval_type": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*(\\.[a-z0-9_-]+)+$"},
              "minimum_count": {"type": "integer", "minimum": 1, "maximum": 20}
            }
          }
        }
      }
    },
    "content_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key_id", "algorithm", "signature", "verified"],
        "properties": {
          "key_id": {"type": "string", "minLength": 3, "maxLength": 200},
          "algorithm": {"type": "string", "minLength": 3, "maxLength": 50},
          "signature": {"type": "string", "minLength": 16, "maxLength": 4096},
          "verified": {"type": "boolean"}
        }
      }
    }
  },
  "$defs": {
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "digest", "verified"],
      "properties": {
        "reference": {"type": "string", "minLength": 3, "maxLength": 200},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "verified": {"type": "boolean"}
      }
    }
  }
}
