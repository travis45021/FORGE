{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/fas/authorization-request.schema.json",
  "title": "Forge Authorization Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "idempotency_key",
    "evaluated_at",
    "authorization_phase",
    "actor",
    "role",
    "readiness_level",
    "granted_scopes",
    "requested_action",
    "approvals",
    "facts",
    "decision_state"
  ],
  "properties": {
    "request_id": { "$ref": "#/$defs/namespacedId" },
    "idempotency_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 200
    },
    "evaluated_at": { "$ref": "#/$defs/timestamp" },
    "authorization_phase": { "enum": ["decision", "execution"] },
    "actor": { "$ref": "#/$defs/actor" },
    "role": { "type": "string", "minLength": 1, "maxLength": 100 },
    "readiness_level": { "type": "integer", "minimum": 0, "maximum": 5 },
    "granted_scopes": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/namespacedName" }
    },
    "requested_action": { "$ref": "#/$defs/action" },
    "approvals": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/approval" }
    },
    "facts": {
      "type": "object",
      "maxProperties": 200,
      "additionalProperties": true
    },
    "decision_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "disposition",
        "signature_verified",
        "superseded",
        "revoked"
      ],
      "properties": {
        "decision_id": {
          "oneOf": [
            { "$ref": "#/$defs/namespacedId" },
            { "type": "null" }
          ]
        },
        "disposition": {
          "enum": [
            "none",
            "proposed",
            "approved",
            "rejected",
            "deferred",
            "blocked",
            "superseded",
            "revoked"
          ]
        },
        "signature_verified": { "type": "boolean" },
        "superseded": { "type": "boolean" },
        "revoked": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "namespacedId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200,
      "pattern": "^[a-z][a-z0-9_.-]*:[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "namespacedName": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200,
      "pattern": "^[a-z][a-z0-9_.-]*(\\.[a-z0-9_-]+)+$"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "actor_type", "version"],
      "properties": {
        "actor_id": { "$ref": "#/$defs/namespacedId" },
        "actor_type": {
          "enum": [
            "user",
            "admin",
            "architect",
            "ai_model",
            "ai_council",
            "sentinel",
            "service",
            "integration"
          ]
        },
        "version": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_type", "target_refs", "parameters"],
      "properties": {
        "action_type": { "$ref": "#/$defs/namespacedName" },
        "target_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/namespacedId" }
        },
        "parameters": {
          "type": "object",
          "maxProperties": 100,
          "additionalProperties": true
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_id",
        "approval_type",
        "approved_at",
        "expires_at",
        "verified"
      ],
      "properties": {
        "approval_id": { "$ref": "#/$defs/namespacedId" },
        "approval_type": { "$ref": "#/$defs/namespacedName" },
        "approved_at": { "$ref": "#/$defs/timestamp" },
        "expires_at": { "$ref": "#/$defs/timestamp" },
        "verified": { "type": "boolean" }
      }
    }
  }
}

