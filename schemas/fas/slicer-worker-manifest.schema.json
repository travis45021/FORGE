{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/fas/slicer-worker-manifest.schema.json",
  "title": "FORGE Slicer Worker Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["worker_id", "context", "workspace", "limits", "forbidden_capabilities"],
  "properties": {
    "worker_id": {"type": "string", "minLength": 1},
    "context": {"enum": ["production", "twin"]},
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output", "logs"],
      "properties": {
        "input": {"type": "string", "minLength": 1},
        "output": {"type": "string", "minLength": 1},
        "logs": {"type": "string", "minLength": 1}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_seconds", "memory_bytes", "disk_bytes"],
      "properties": {
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "memory_bytes": {"type": "integer", "minimum": 1},
        "disk_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "forbidden_capabilities": {
      "type": "array",
      "contains": {"const": "printer_control"},
      "items": {"type": "string"}
    }
  }
}
