{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/fas/slicer-result.schema.json",
  "title": "FORGE Slicer Result",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "succeeded"}},
        "required": ["status"]
      },
      "then": {"required": ["artifact_digest"]},
      "else": {
        "properties": {"artifact_digest": {"type": "null"}}
      }
    }
  ],
  "required": ["contract_version", "request_id", "status", "context", "engine", "warnings", "authority"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "request_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["succeeded", "failed", "cancelled", "timed_out"]},
    "context": {"enum": ["production", "twin"]},
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "source_digest", "build_digest"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "source_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "build_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "artifact_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "warnings": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["can_upload", "can_start_print"],
      "properties": {
        "can_upload": {"const": false},
        "can_start_print": {"const": false}
      }
    }
  }
}
