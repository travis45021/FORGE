{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/fas/forge-object.schema.json",
  "title": "FORGE Object",
  "type": "object",
  "additionalProperties": false,
  "required": ["object_id", "object_type", "display_name", "owner_scope", "lifecycle_state", "knowledge_state", "version", "capabilities", "state", "health", "limits", "policies", "evidence_refs", "metadata", "unknown_fields", "creation_source", "created_at", "updated_at", "reason"],
  "properties": {
    "object_id": {"$ref": "#/$defs/id"},
    "object_type": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"},
    "display_name": {"type": "string", "minLength": 1},
    "owner_scope": {"$ref": "#/$defs/id"},
    "lifecycle_state": {"enum": ["declared", "discovered", "configured", "provisional", "validated", "active", "degraded", "unavailable", "retired"]},
    "knowledge_state": {"enum": ["unknown", "user_declared", "detected_unverified", "locally_measured", "validated", "conflicting", "expired"]},
    "version": {"type": "integer", "minimum": 1},
    "capabilities": {"$ref": "#/$defs/uniqueStrings"},
    "state": {"type": "object"},
    "health": {
      "type": "object",
      "required": ["state", "updated_at"],
      "properties": {
        "state": {"enum": ["healthy", "unobserved", "stale", "degraded", "unavailable", "failed", "recovering"]},
        "updated_at": {"$ref": "#/$defs/time"}
      }
    },
    "limits": {"type": "object"},
    "policies": {"$ref": "#/$defs/uniqueStrings"},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "metadata": {"type": "object"},
    "unknown_fields": {"$ref": "#/$defs/uniqueStrings"},
    "creation_source": {"type": "string", "minLength": 1},
    "created_at": {"$ref": "#/$defs/time"},
    "updated_at": {"$ref": "#/$defs/time"},
    "reason": {"type": "string", "minLength": 3}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*:[A-Za-z0-9][A-Za-z0-9_.:-]*$"},
    "time": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "uniqueStrings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
