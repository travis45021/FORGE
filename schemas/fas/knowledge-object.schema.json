{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/fas/knowledge-object.schema.json",
  "title": "FORGE Knowledge Object",
  "type": "object",
  "additionalProperties": false,
  "required": ["knowledge_id", "knowledge_type", "subject_id", "predicate", "value", "scope", "confidence", "source_class", "source_refs", "origin", "created_at", "updated_at", "last_verified_at", "expires_at", "status", "requires_verification", "depends_on", "supersedes", "superseded_by", "reason"],
  "properties": {
    "knowledge_id": {"$ref": "#/$defs/id"},
    "knowledge_type": {"enum": ["observed_data", "evidence", "fact", "user_statement", "measurement", "inference", "prediction", "preference", "policy_reference", "outcome", "unknown"]},
    "subject_id": {"$ref": "#/$defs/id"},
    "predicate": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "value": {},
    "scope": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "source_class": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "origin": {"enum": ["local", "shared", "imported"]},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "updated_at": {"$ref": "#/$defs/timestamp"},
    "last_verified_at": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/timestamp"}]},
    "expires_at": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/timestamp"}]},
    "status": {"enum": ["provisional", "active", "stale", "disputed", "superseded", "retired", "invalidated", "advisory"]},
    "requires_verification": {"type": "boolean"},
    "depends_on": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "supersedes": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]},
    "superseded_by": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]},
    "reason": {"type": "string", "minLength": 3, "maxLength": 500}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*:[A-Za-z0-9][A-Za-z0-9_.:-]*$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "Z$"}
  }
}
