{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/fas/interface-request.schema.json",
  "title": "FORGE FAS-024 Interface Request",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "safeValue": {
      "anyOf": [
        {"$ref": "#/$defs/safeObject"},
        {
          "type": "array",
          "items": {"$ref": "#/$defs/safeValue"}
        },
        {"type": ["string", "number", "boolean", "null"]}
      ]
    },
    "safeObject": {
      "type": "object",
      "propertyNames": {
        "not": {"const": "raw_hardware_command"}
      },
      "additionalProperties": {"$ref": "#/$defs/safeValue"}
    }
  },
  "required": ["request_id", "api_version", "action", "target", "parameters"],
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "api_version": {"const": "v1"},
    "action": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "parameters": {"$ref": "#/$defs/safeObject"},
    "client_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["simple", "builder", "advanced", "accessible", "developer"]},
        "data_behavior": {"enum": ["local_only", "network_requested"]}
      }
    }
  }
}
