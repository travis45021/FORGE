{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/fas/ledger-amendment.schema.json",
  "title": "Forge Ledger Amendment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "amendment_id",
    "schema_version",
    "recorded_at",
    "target_type",
    "target_id",
    "reason",
    "operations",
    "authority",
    "previous_record_hash",
    "record_hash",
    "signature"
  ],
  "properties": {
    "amendment_id": { "$ref": "#/$defs/namespacedId" },
    "schema_version": { "type": "string", "const": "1.0.0" },
    "recorded_at": { "$ref": "#/$defs/timestamp" },
    "target_type": { "enum": ["decision", "evidence"] },
    "target_id": { "$ref": "#/$defs/namespacedId" },
    "reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["op", "path", "value"],
        "properties": {
          "op": { "enum": ["add", "replace"] },
          "path": {
            "type": "string",
            "pattern": "^/(summary|rationale|limitations|privacy/redaction_status|storage/uri)(/.*)?$"
          },
          "value": {}
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "policy_ref"],
      "properties": {
        "actor_id": { "$ref": "#/$defs/namespacedId" },
        "policy_ref": { "$ref": "#/$defs/namespacedId" }
      }
    },
    "previous_record_hash": {
      "oneOf": [
        { "$ref": "#/$defs/sha256" },
        { "type": "null" }
      ]
    },
    "record_hash": { "$ref": "#/$defs/sha256" },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "signer_id", "value"],
      "properties": {
        "algorithm": { "enum": ["ed25519", "ecdsa-p256-sha256"] },
        "key_id": { "$ref": "#/$defs/namespacedId" },
        "signer_id": { "$ref": "#/$defs/namespacedId" },
        "value": {
          "type": "string",
          "minLength": 16,
          "maxLength": 4096
        }
      }
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "namespacedId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200,
      "pattern": "^[a-z][a-z0-9_.-]*:[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
