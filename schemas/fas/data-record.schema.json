{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/fas/data-record.schema.json",
  "title": "FORGE Local Data Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_id", "schema_version", "owner_scope", "data_class", "value", "authoritative", "created_at", "updated_at", "retention_class", "provenance_refs", "digest"],
  "properties": {
    "record_id": {"$ref": "#/$defs/id"},
    "schema_version": {"const": "1.0.0"},
    "owner_scope": {"$ref": "#/$defs/id"},
    "data_class": {"enum": ["ephemeral", "operational_state", "durable_local", "audit", "evidence", "secret"]},
    "value": {},
    "authoritative": {"type": "boolean"},
    "created_at": {"$ref": "#/$defs/time"},
    "updated_at": {"$ref": "#/$defs/time"},
    "retention_class": {"$ref": "#/$defs/name"},
    "provenance_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*:[A-Za-z0-9][A-Za-z0-9_.:-]*$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 100},
    "time": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
