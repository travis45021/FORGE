{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/fas/policy.schema.json",
  "title": "Forge Authorization Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_id",
    "version",
    "description",
    "enabled",
    "priority",
    "effect",
    "action_patterns",
    "actor_types",
    "roles",
    "minimum_readiness_level",
    "maximum_readiness_level",
    "required_scopes",
    "required_approvals",
    "when_facts",
    "parameter_constraints",
    "obligations"
  ],
  "properties": {
    "policy_id": { "$ref": "#/$defs/namespacedId" },
    "version": { "type": "string", "minLength": 1, "maxLength": 100 },
    "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "enabled": { "type": "boolean" },
    "priority": { "type": "integer", "minimum": 0, "maximum": 1000000 },
    "effect": { "enum": ["allow", "deny"] },
    "action_patterns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/actionPattern" }
    },
    "actor_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/actorType" }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 100 }
    },
    "minimum_readiness_level": { "type": "integer", "minimum": 0, "maximum": 5 },
    "maximum_readiness_level": { "type": "integer", "minimum": 0, "maximum": 5 },
    "required_scopes": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/namespacedName" }
    },
    "required_approvals": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/approvalRequirement" }
    },
    "when_facts": {
      "type": "object",
      "maxProperties": 100,
      "additionalProperties": {
        "oneOf": [
          { "type": "string" },
          { "type": "number" },
          { "type": "boolean" },
          { "type": "null" }
        ]
      }
    },
    "parameter_constraints": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/parameterConstraint" }
    },
    "obligations": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/namespacedName" }
    }
  },
  "$defs": {
    "namespacedId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200,
      "pattern": "^[a-z][a-z0-9_.-]*:[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "namespacedName": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200,
      "pattern": "^[a-z][a-z0-9_.-]*(\\.[a-z0-9_*?-]+)+$"
    },
    "actionPattern": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200,
      "pattern": "^[a-z][a-z0-9_.-]*(\\.[a-z0-9_*?-]+)+$"
    },
    "actorType": {
      "enum": [
        "user",
        "admin",
        "architect",
        "ai_model",
        "ai_council",
        "sentinel",
        "service",
        "integration"
      ]
    },
    "approvalRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approval_type", "minimum_count"],
      "properties": {
        "approval_type": { "$ref": "#/$defs/namespacedName" },
        "minimum_count": { "type": "integer", "minimum": 1, "maximum": 20 }
      }
    },
    "parameterConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameter", "required", "on_violation"],
      "properties": {
        "parameter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
        },
        "required": { "type": "boolean" },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "on_violation": { "enum": ["reject", "clamp"] }
      },
      "anyOf": [
        {
          "properties": { "minimum": { "type": "number" } },
          "required": ["minimum"]
        },
        {
          "properties": { "maximum": { "type": "number" } },
          "required": ["maximum"]
        }
      ]
    }
  }
}
