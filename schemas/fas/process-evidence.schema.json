{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/fas/process-evidence.schema.json",
  "title": "FORGE Contract-Only Process Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "outcome",
    "returncode",
    "stdout_bytes",
    "stderr_bytes",
    "stdout_digest",
    "stderr_digest",
    "shell_used",
    "physical_commands_allowed",
    "release_authority_granted",
    "worker_reuse_allowed",
    "resource_limits_enforced",
    "requires_reviewed_resource_supervisor"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "outcome": {"enum": ["completed", "crashed", "timed_out", "cancelled"]},
    "returncode": {"type": "integer"},
    "stdout_bytes": {"type": "integer", "minimum": 0},
    "stderr_bytes": {"type": "integer", "minimum": 0},
    "stdout_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "stderr_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "shell_used": {"const": false},
    "physical_commands_allowed": {"const": false},
    "release_authority_granted": {"const": false},
    "worker_reuse_allowed": {"const": false},
    "resource_limits_enforced": {"const": false},
    "requires_reviewed_resource_supervisor": {"const": true}
  }
}
