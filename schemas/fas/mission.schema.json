{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/fas/mission.schema.json",
  "title": "Forge Mission",
  "type": "object",
  "additionalProperties": false,
  "required": ["mission_id", "schema_version", "template_ref", "objective", "state", "requirements", "constraints", "context", "evidence_refs", "dependencies", "capability_requirements", "plan", "risk_assessment", "approval_requirements", "monitoring_rules", "recovery_strategy", "completion_criteria", "report_requirements", "correlation_id", "revision"],
  "properties": {
    "mission_id": {"$ref": "#/$defs/id"},
    "schema_version": {"const": "1.0.0"},
    "template_ref": {"oneOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]},
    "objective": {"type": "string", "minLength": 1, "maxLength": 2000},
    "state": {"enum": ["created", "validated", "planned", "waiting", "approved", "executing", "monitoring", "completed", "verified", "archived", "paused", "cancelled", "failed", "aborted", "recovering", "suspended"]},
    "requirements": {"type": "array", "items": {"type": "object"}},
    "constraints": {"type": "array", "items": {"type": "object"}},
    "context": {"type": "object"},
    "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "dependencies": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "capability_requirements": {"type": "array", "items": {"$ref": "#/$defs/capabilityRequirement"}},
    "plan": {"type": "array", "items": {"$ref": "#/$defs/step"}},
    "risk_assessment": {"type": "object"},
    "approval_requirements": {"type": "array", "items": {"type": "object"}},
    "monitoring_rules": {"type": "array", "items": {"type": "object"}},
    "recovery_strategy": {"type": "object"},
    "completion_criteria": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "report_requirements": {"type": "array", "items": {"type": "object"}},
    "correlation_id": {"$ref": "#/$defs/id"},
    "revision": {"type": "integer", "minimum": 1}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*:[A-Za-z0-9][A-Za-z0-9_.:-]*$", "maxLength": 200},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*(\\.[a-z0-9_-]+)+$", "maxLength": 200},
    "ref": {"type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": {"id": {"$ref": "#/$defs/id"}, "version": {"type": "string", "minLength": 1}}},
    "capabilityRequirement": {"type": "object", "additionalProperties": false, "required": ["capability_id", "version_constraint", "operations"], "properties": {"capability_id": {"$ref": "#/$defs/name"}, "version_constraint": {"type": "string", "minLength": 1}, "operations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/name"}}}},
    "step": {"type": "object", "additionalProperties": false, "required": ["step_id", "capability_id", "operation", "parameters"], "properties": {"step_id": {"$ref": "#/$defs/id"}, "capability_id": {"$ref": "#/$defs/name"}, "operation": {"$ref": "#/$defs/name"}, "parameters": {"type": "object"}}}
  }
}
